function renderTourMap(){
  var svg = document.getElementById('tour-svg');
  if (!svg) return;
  var NS = 'http://www.w3.org/2000/svg';
  var defs = document.createElementNS(NS,'defs');
  defs.innerHTML =
    '<filter id="lm-shadow" x="-40%" y="-40%" width="180%" height="180%">' +
      '<feDropShadow dx="0" dy="3" stdDeviation="3.5" flood-color="#3A3127" flood-opacity="0.28"/>' +
    '</filter>' +
    '<marker id="tour-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">' +
      '<path d="M0,0 L10,5 L0,10 z" fill="#A99B87"/></marker>';
  svg.appendChild(defs);

  // 背景：田野色块与道路
  var bg = [
    '<rect x="0" y="0" width="1000" height="640" fill="#F6F1E7"/>',
    '<rect x="40" y="440" width="260" height="170" rx="18" fill="#DCE8CF"/>',
    '<rect x="760" y="430" width="210" height="180" rx="18" fill="#E7E2C6"/>',
    '<rect x="60" y="50" width="230" height="150" rx="18" fill="#E2E6C9"/>',
    '<rect x="540" y="50" width="220" height="120" rx="18" fill="#DCE6CE"/>',
    '<rect x="640" y="280" width="280" height="120" rx="18" fill="#D9E6EC"/>',
    '<rect x="60" y="250" width="200" height="150" rx="16" fill="#EFE4D2"/>',
    '<rect x="330" y="470" width="280" height="140" rx="18" fill="#DCE8CF"/>',
    '<path d="M300 640 C 330 530, 250 470, 320 400 C 380 340, 330 280, 400 210" stroke="#EADFC6" stroke-width="26" fill="none" stroke-linecap="round"/>',
    '<path d="M0 300 C 240 280, 520 320, 1000 250" stroke="#CFE0DE" stroke-width="10" fill="none" stroke-linecap="round" opacity="0.7"/>',
    '<circle cx="110" cy="380" r="22" fill="#CBDDB6"/>',
    '<circle cx="900" cy="600" r="20" fill="#CBDDB6"/>',
    '<circle cx="880" cy="200" r="18" fill="#CBDDB6"/>',
    '<text x="500" y="36" text-anchor="middle" font-size="17" font-weight="700" fill="#5A4F42">花茂村旅游动线示意图（九个点位）</text>',
    '<text x="500" y="622" text-anchor="middle" font-size="12" fill="#9B8F7D">北  ↑　虚线为建议游览动线　·　图形为卡通示意</text>'
  ].join('');
  svg.insertAdjacentHTML('beforeend', bg);

  // 动线（虚线 + 箭头）
  var order = ['gouba-site','gouba-mem','redhome','pottery','paper','jiufeng','field'];
  var pts = order.map(function(id){ return TOUR_POIS.find(function(p){ return p.id === id; }); });
  var d = '';
  for (var i = 0; i < pts.length; i++){
    var x = pts[i].x, y = pts[i].y;
    if (i === 0) d += 'M ' + x + ' ' + y;
    else {
      var px = pts[i-1].x, py = pts[i-1].y;
      var mx = (px + x) / 2;
      d += ' C ' + (mx + 30) + ' ' + py + ', ' + (mx - 30) + ' ' + y + ', ' + x + ' ' + y;
    }
  }
  var ln = document.createElementNS(NS,'path');
  ln.setAttribute('d', d);
  ln.setAttribute('fill','none');
  ln.setAttribute('stroke','#A99B87');
  ln.setAttribute('stroke-width','2.4');
  ln.setAttribute('stroke-dasharray','8 7');
  ln.setAttribute('marker-end','url(#tour-arr)');
  svg.appendChild(ln);

  // 接驳关系小箭头 + 小字（原“与文旅的接驳”框移入图中）
  function addLinkArrow(x1,y1,x2,y2,label,labelDy){
    var g = document.createElementNS(NS,'g');
    var p = document.createElementNS(NS,'path');
    p.setAttribute('d','M '+x1+' '+y1+' L '+x2+' '+y2);
    p.setAttribute('fill','none'); p.setAttribute('stroke','#9E2B25');
    p.setAttribute('stroke-width','1.6'); p.setAttribute('stroke-dasharray','4 3');
    p.setAttribute('marker-end','url(#arr-link)');
    g.appendChild(p);
    var t = document.createElementNS(NS,'text');
    t.setAttribute('x',(x1+x2)/2); t.setAttribute('y',(y1+y2)/2 + (labelDy||-6));
    t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','11');
    t.setAttribute('fill','#9E2B25'); t.setAttribute('font-weight','600');
    t.textContent = label;
    g.appendChild(t);
    svg.appendChild(g);
  }
  // 箭头 marker
  var mk = document.createElementNS(NS,'marker');
  mk.setAttribute('id','arr-link'); mk.setAttribute('viewBox','0 0 10 10');
  mk.setAttribute('refX','9'); mk.setAttribute('refY','5');
  mk.setAttribute('markerWidth','6'); mk.setAttribute('markerHeight','6');
  mk.setAttribute('orient','auto-start-reverse');
  mk.innerHTML = '<path d="M0,0 L10,5 L0,10 z" fill="#9E2B25"/>';
  svg.querySelector('defs').appendChild(mk);
  addLinkArrow(300,180,215,290,'导入红色游客',4);
  addLinkArrow(215,360,340,415,'延伸非遗体验',-4);
  addLinkArrow(560,410,660,500,'组合研学内容',4);

  // 地标
  TOUR_POIS.forEach(function(p){
    var g = document.createElementNS(NS,'g');
    g.setAttribute('class','landmark');
    g.setAttribute('data-poi', p.id);
    g.setAttribute('role','button');
    g.setAttribute('tabindex','0');
    g.setAttribute('aria-label','定位到 ' + p.name);
    g.setAttribute('transform','translate(' + p.x + ',' + p.y + ')');
    var ring = '<g class="lm-ring">' +
      '<circle cx="0" cy="0" r="46" fill="#FFFDF8" stroke="' + p.color + '" stroke-width="4" filter="url(#lm-shadow)"/>' +
      '<circle cx="0" cy="0" r="46" fill="none" stroke="#FFFFFF" stroke-opacity="0.45" stroke-width="1.5"/>' +
      '</g>';
    g.insertAdjacentHTML('beforeend', ring);
    var ic = document.createElementNS(NS,'g');
    ic.setAttribute('transform','translate(-32,-32)');
    ic.setAttribute('width','64'); ic.setAttribute('height','64');
    ic.insertAdjacentHTML('beforeend', ICON_SVG[p.icon]);
    g.appendChild(ic);
    var nm = document.createElementNS(NS,'text');
    nm.setAttribute('class','lm-name');
    nm.setAttribute('x','0'); nm.setAttribute('y','74');
    nm.setAttribute('text-anchor','middle');
    nm.setAttribute('font-size','15');
    nm.setAttribute('font-weight','700');
    nm.setAttribute('fill','#2B2620');
    nm.textContent = p.short;
    g.appendChild(nm);
    var ch = document.createElementNS(NS,'text');
    ch.setAttribute('class','lm-name');
    ch.setAttribute('x','0'); ch.setAttribute('y','92');
    ch.setAttribute('text-anchor','middle');
    ch.setAttribute('font-size','11');
    ch.setAttribute('fill', p.color);
    ch.setAttribute('font-weight','600');
    ch.textContent = p.tag;
    g.appendChild(ch);
    svg.appendChild(g);
  });

  // 交互：点击地标 → 跳转下方介绍；键盘可达
  svg.addEventListener('click', function(ev){
    var g = ev.target.closest ? ev.target.closest('.landmark') : null;
    if (g) goIntro(g.getAttribute('data-poi'));
  });
  svg.addEventListener('keydown', function(ev){
    if (ev.key !== 'Enter' && ev.key !== ' ') return;
    var g = ev.target.closest ? ev.target.closest('.landmark') : null;
    if (g){ ev.preventDefault(); goIntro(g.getAttribute('data-poi')); }
  });
}

/* 平滑滚动（不用 scrollIntoView） */
function smoothTo(el, offset){
  var top = el.getBoundingClientRect().top + (window.pageYOffset || document.documentElement.scrollTop) - (offset || 80);
  window.scrollTo({top: top, behavior: 'smooth'});
}
function goIntro(id){
  var el = document.getElementById('case-' + id);
  if (!el) el = document.querySelector('.poi-item[data-poi="' + id + '"]');
  if (!el) return;
  hideBackHint();
  smoothTo(el, 70);
  el.classList.add('flash');
  setTimeout(function(){ el.classList.remove('flash'); }, 2200);
}
function showBackHint(id){
  var box = document.getElementById('map-back-hint');
  if (!box) return;
  var p = TOUR_POIS.find(function(x){return x.id===id;});
  var hasCase = !!document.getElementById('case-' + id);
  if (!hasCase){ box.classList.remove('show'); return; }
  box.innerHTML = '已定位到 <b>' + (p?p.name:id) + '</b> · 再次点击该地标可返回案例卡';
  box.classList.add('show');
}
function hideBackHint(){
  var box = document.getElementById('map-back-hint');
  if (box) box.classList.remove('show');
}
function goLandmark(id){
  var shell = document.querySelector('.tour-shell');
  if (shell) smoothTo(shell, 70);
  var g = document.querySelector('.landmark[data-poi="' + id + '"]');
  if (g){
    g.classList.remove('lm-flash');
    void g.getBoundingClientRect();
    g.classList.add('lm-flash');
    setTimeout(function(){ g.classList.remove('lm-flash'); }, 2400);
  }
  showBackHint(id);
}
function renderPoiList(){
  var box = document.getElementById('poi-list');
  box.innerHTML = TOUR_POIS.map(function(p){
    return '<div class="poi-item" style="border-left-color:' + p.color + '" data-poi="' + p.id + '" tabindex="0" role="button" aria-label="查看 ' + p.name + '">' +
      '<div class="pt"><i style="background:' + p.color + '"></i>' + p.name +
      '<span class="ptg">' + p.chain + '</span></div>' +
      '<div class="pi">' + p.intro + '</div></div>';
  }).join('');
  box.querySelectorAll('.poi-item').forEach(function(el){
    var p = TOUR_POIS.find(function(x){ return x.id === el.getAttribute('data-poi'); });
    function go(){ goLandmark(p.id); }
    el.addEventListener('click', go);
    el.addEventListener('keydown', function(ev){ if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); go(); } });
  });
}

/* 案例卡“查看点位”按钮：跳转示意图并高亮地标 */
function bindCaseGoto(){
  document.querySelectorAll('.cc-goto').forEach(function(btn){
    btn.addEventListener('click', function(){
      var id = btn.getAttribute('data-goto');
      if (id && window.goLandmark) goLandmark(id);
    });
  });
}

/* ============================================================
   启动
   ============================================================ */
(function boot(){
  renderGraph();
  bindGraph();
  renderLegend();
  renderTourMap();
  renderPoiList();
  bindCaseGoto();
})();
</script>
</body>
</html>
