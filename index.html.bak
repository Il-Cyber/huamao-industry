  {id:'n1', lane:0, name:'耕地与农田', chain:'农业', desc:'全村国土面积 9.8 平方公里、耕地约 5531 亩；过去多“巴掌田”“鸡窝地”，经土地整治、集中流转与宜机化改造后由零散小块变为连片生产空间。'},
  {id:'n2', lane:0, name:'土陶技艺', chain:'非遗', desc:'贵州省级非物质文化遗产，第四代传承人主持陶艺馆，是“陶瓷之乡”的产业根基。'},
  {id:'n3', lane:0, name:'古法造纸技艺', chain:'非遗', desc:'外婆传下的古法造纸，与纸浆压花结合，转化为可体验、可带走的文创。'},
  {id:'n4', lane:0, name:'红色文化', chain:'红色', desc:'苟坝会议、马灯精神、红军过境故事，构成研学和乡村旅游的资源底色。'},
  {id:'n5', lane:1, name:'村党组织·村集体', chain:'双链', desc:'“党总支＋合作社＋农户”的统筹核心：土地整合、群众动员、产业组织、利益协调。'},
  {id:'n6', lane:1, name:'合作社', chain:'农业', desc:'2016 年依托山东寿光九丰的管理与技术创建的遵义绿动九丰蔬菜种植专业合作社：组织生产、连接农户，提供育苗、机耕、植保、无人机飞防等农业社会化服务。'},
  {id:'n7', lane:1, name:'农业企业（九丰）', chain:'农业', desc:'2014 年引入的山东寿光九丰农业科技有限公司：导入技术、品种、管理方式与市场经验，建设现代高效农业园区。'},
  {id:'n8', lane:1, name:'非遗传承人·工坊', chain:'非遗', desc:'土陶第四代传承人、“花茂人家”返乡大学生及其他返乡人才等，传承技艺并参与产品创新。'},
  {id:'n9', lane:1, name:'文旅经营者·农家乐', chain:'非遗', desc:'红色之家等农家乐与民宿经营者，提供餐饮接待、故事讲述与住宿服务。'},
  {id:'n27', lane:2, name:'种养大户（22 户）', chain:'农业', desc:'全村已培育 22 户种养大户，承接规模化生产、技术推广与订单对接，是村级经营网络的重要一环。'},
  {id:'n10', lane:2, name:'土地流转·规模种植', chain:'农业', desc:'全村集中流转土地约 2350 亩，高标准农田建设与宜机化改造后，蔬菜、脆红李、“稻＋”、烤烟等规模种植。'},
  {id:'n11', lane:2, name:'土陶制作·烧制', chain:'非遗', desc:'从塑形到入窑的完整制陶过程；柴窑改电窑是生产方式调整的典型细节。'},
  {id:'n12', lane:2, name:'纸浆压花制作', chain:'非遗', desc:'把传统工序转化为可观看、可参与的手作过程。'},
  {id:'n13', lane:2, name:'红色参观·研学', chain:'红色', desc:'苟坝会议纪念馆及遗址参观，延伸到乡村餐饮与交流场景。'},
  {id:'n14', lane:2, name:'农事体验·认养', chain:'农业', desc:'“我在花茂有块田”：犁地、播种、采摘，让游客从观看田园转向参与农事。'},
  {id:'n26', lane:2, name:'设施农业（蔬菜大棚）', chain:'农业', desc:'九丰园区内绿动九丰合作社在 360 亩土地上建 34 个蔬菜大棚，种植花菜、西红柿、黄瓜、茄子等；其中一季约 30 亩花菜预计产量 18 万斤、毛收入约 17—18 万元。'},
  {id:'n15', lane:3, name:'农产品', chain:'农业', desc:'露天蔬菜、脆红李、水稻“稻＋”、烤烟等多元农产品；2024 年蔬菜 1400 亩、“稻＋”1214 亩、烤烟 900 亩。'},
  {id:'n16', lane:3, name:'陶艺产品·体验', chain:'非遗', desc:'游客既能看成品，也能亲手拉坯“玩泥巴”。'},
  {id:'n17', lane:3, name:'文创（压花画等）', chain:'非遗', desc:'压花画、小夜灯、冰箱贴——“能带得走的乡愁”。'},
  {id:'n18', lane:3, name:'特色餐饮·民宿', chain:'非遗', desc:'盬子鸡、八仙桌、乡村故事：餐饮不仅是消费，也承载文化体验。'},
  {id:'n19', lane:3, name:'研学课程·认养田', chain:'农业', desc:'农事体验兼具劳动教育与自然教育属性，接入学研学路线。'},
  {id:'n20', lane:4, name:'游客·研学团队', chain:'双链', desc:'2025 年接待游客 71.25 万人次；研学团队是重要的体验与消费群体。'},
  {id:'n21', lane:4, name:'农产品销售·订单', chain:'农业', desc:'订单农业与本地市场直供；合作社向农户和周边村镇扩散技术、市场与信息。'},
  {id:'n22', lane:4, name:'电商·线下特色店', chain:'非遗', desc:'文创产品与特色农产品通过线下店铺和线上渠道触达游客。'},
  {id:'n23', lane:5, name:'村民增收·集体经济', chain:'双链', desc:'土地租金＋务工工资＋入股分红＋集体收益，“一地多收益”；增值收益农户 70%、集体 30%，合作社累计带动 1000 户脱贫户、发放 170 万元分红、帮助 50 户稳定就业，6 年累计发放工资近 1000 万元。'},
  {id:'n24', lane:5, name:'文化传承·人才回流', chain:'双链', desc:'非遗从“保护对象”变为“发展资源”，返乡大学生参与产品创新。'},
  {id:'n25', lane:5, name:'问题与约束', chain:'问题', issue:true, desc:'住宿消费不足、非遗手工产能有限、青年人才不足、产业数据分散、公共服务有短板。'}
];
var EDGES = [
  {f:'n5', t:'n6', w:'领办组建'},
  {f:'n5', t:'n9', w:'引进合作'},
  {f:'n5', t:'n10', w:'统筹推动'},
  {f:'n6', t:'n10', w:'组织生产'},
  {f:'n7', t:'n10', w:'注入技术'},
  {f:'n10', t:'n15', w:'生产供应'},
  {f:'n15', t:'n21', w:'对接订单'},
  {f:'n7', t:'n14', w:'打造项目'},
  {f:'n14', t:'n19', w:'提供体验'},
  {f:'n20', t:'n19', w:'参与研学', side:'right'},
  {f:'n20', t:'n18', w:'到店消费', side:'top'},
  {f:'n20', t:'n16', w:'体验购买', side:'top'},
  {f:'n20', t:'n17', w:'购买文创', side:'top'},
  {f:'n8', t:'n11', w:'传承技艺'},
  {f:'n8', t:'n12', w:'传承创新'},
  {f:'n11', t:'n16', w:'烧制成品'},
  {f:'n12', t:'n17', w:'制作文创'},
  {f:'n9', t:'n18', w:'经营接待'},
  {f:'n4', t:'n13', w:'承载记忆'},
  {f:'n13', t:'n18', w:'导入客流'},
  {f:'n10', t:'n23', w:'土地租金'},
  {f:'n15', t:'n23', w:'务工工资'},
  {f:'n18', t:'n23', w:'增加就业'},
  {f:'n8', t:'n24', w:'吸引返乡'},
  {f:'n12', t:'n22', w:'进入渠道'},
  {f:'n22', t:'n20', w:'触达游客'},
  {f:'n6', t:'n26', w:'建设运营'},
  {f:'n7', t:'n26', w:'导入技术'},
  {f:'n26', t:'n15', w:'设施产出'},
  {f:'n10', t:'n27', w:'培育大户'},
  {f:'n27', t:'n15', w:'规模种植'},
  {f:'n18', t:'n25', w:'制约·住宿消费不足'},
  {f:'n8', t:'n25', w:'制约·手工产能有限'},
  {f:'n20', t:'n25', w:'制约·当日游为主'},
  {f:'n24', t:'n25', w:'制约·青年人才不足'}
];
var nodeById = {};
NODES.forEach(function(n){ nodeById[n.id] = n; });

/* ============================================================
   六层总图渲染（确定性 SVG 布局）
   ============================================================ */
var SVG_W = 1200, SVG_H = 690, LANE_TOP = 46, NODE_H = 46, NODE_W = 152;
var LANE_Y0 = 96, LANE_Y1 = 640;
var pos = {}; // nodeId -> {x, y}
NODES.forEach(function(n){
  var count = NODES.filter(function(m){ return m.lane === n.lane; }).length;
  var i = NODES.filter(function(m){ return m.lane === n.lane && m.id <= n.id; }).length - 1;
  var y;
  if (count === 1) y = (LANE_Y0 + LANE_Y1) / 2;
  else y = LANE_Y0 + i * (LANE_Y1 - LANE_Y0) / (count - 1);
  var laneW = SVG_W / 6;
  var x = laneW * n.lane + laneW / 2;
  pos[n.id] = {x:x, y:y};
});
function edgePath(e){
  var p1 = pos[e.f], p2 = pos[e.t];
  var side = e.side || 'left';
  // 同列节点：垂直走线
  if (Math.abs(p1.x - p2.x) < 5 && !e.side) {
    var xv1, yv1, xv2, yv2;
    if (p1.y < p2.y) {
      // f 在 t 上方：从 f 底部到 t 顶部
      xv1 = p1.x; yv1 = p1.y + NODE_H/2 + 8;
      xv2 = p2.x; yv2 = p2.y - NODE_H/2 - 8;
    } else {
      // f 在 t 下方：从 f 顶部到 t 底部
      xv1 = p1.x; yv1 = p1.y - NODE_H/2 - 8;
      xv2 = p2.x; yv2 = p2.y + NODE_H/2 + 8;
    }
    var mvy = (yv1 + yv2) / 2;
    return 'M '+xv1+' '+yv1+' C '+xv1+' '+mvy+', '+xv2+' '+mvy+', '+xv2+' '+yv2;
  }
  if (side === 'top') {
    // 从 f 右边缘到 t 顶部中心，垂直下来
    var xt1 = p1.x + NODE_W/2 + 8, yt1 = p1.y;
    var xt2 = p2.x, yt2 = p2.y - NODE_H/2 - 8;
    var my = (yt1 + yt2) / 2;
    return 'M '+xt1+' '+yt1+' C '+xt1+' '+my+', '+xt2+' '+my+', '+xt2+' '+yt2;
  }
  if (side === 'right') {
    // 从 f 右边缘到 t 右边缘（箭头从右侧进入 t）
    var xr1 = p1.x + NODE_W/2 + 8, yr1 = p1.y;
    var xr2 = p2.x + NODE_W/2 + 8, yr2 = p2.y;
    var mxr = (xr1 + xr2) / 2;
    var ctrlr = 70;
    return 'M '+xr1+' '+yr1+' C '+(mxr+ctrlr)+' '+yr1+', '+(mxr-ctrlr)+' '+yr2+', '+xr2+' '+yr2;
  }
  // 默认：从 f 右边缘到 t 左边缘
  var x1 = p1.x + NODE_W/2 + 8, y1 = p1.y;
  var x2 = p2.x - NODE_W/2 - 8, y2 = p2.y;
  var mx = (x1 + x2) / 2;
  var ctrl = 70;
  return 'M '+x1+' '+y1+' C '+(mx+ctrl)+' '+y1+', '+(mx-ctrl)+' '+y2+', '+x2+' '+y2;
}
function edgeMid(e){
  var p1 = pos[e.f], p2 = pos[e.t];
  if (Math.abs(p1.x - p2.x) < 5 && !e.side) {
    return {x: p1.x, y: (p1.y + p2.y)/2};
  }
  if (e.side === 'top') {
    return {x: (p1.x + p2.x)/2, y: (p1.y + p2.y)/2 - 10};
  }
  return {x:(p1.x + p2.x)/2, y:(p1.y + p2.y)/2};
}
function renderGraph(){
  var svg = document.getElementById('graph-svg');
  var NS = 'http://www.w3.org/2000/svg';
  var defs = document.createElementNS(NS,'defs');
  var mdefs = '<marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="#A99B87"/></marker>';
  Object.keys(CHAIN_COLOR).forEach(function(k){
    mdefs += '<marker id="arr-' + k + '" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="' + CHAIN_COLOR[k] + '"/></marker>';
  });
  defs.innerHTML = mdefs;
  svg.appendChild(defs);

  // 泳道底
  LANES.forEach(function(L, i){
    var laneW = SVG_W / 6;
    var x = laneW * i;
    var r = document.createElementNS(NS,'rect');
    r.setAttribute('x', x + 4); r.setAttribute('y', 14); r.setAttribute('width', laneW - 8); r.setAttribute('height', SVG_H - 28);
    r.setAttribute('rx', 12); r.setAttribute('fill', i % 2 === 0 ? '#FAF6EE' : '#F5EFE3');
    svg.appendChild(r);
    var t = document.createElementNS(NS,'text');
    t.setAttribute('x', x + laneW/2); t.setAttribute('y', 36);
    t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','13.5'); t.setAttribute('font-weight','700');
    t.setAttribute('fill', L.color); t.textContent = L.name;
    svg.appendChild(t);
  });

  // 连线
  EDGES.forEach(function(e, idx){
    var g = document.createElementNS(NS,'g');
    g.setAttribute('data-edge', idx);
    var path = document.createElementNS(NS,'path');
    path.setAttribute('d', edgePath(e));
    path.setAttribute('fill','none');
    path.setAttribute('stroke','#BDB19E');
    path.setAttribute('stroke-width','1.3');
    path.setAttribute('marker-end','url(#arr)');
    g.appendChild(path);
    var mid = edgeMid(e);
    var t = document.createElementNS(NS,'text');
    t.setAttribute('x', mid.x); t.setAttribute('y', mid.y - 7);
    t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','11');
    t.setAttribute('fill','#5A4F42');
    t.setAttribute('data-word','1');
    t.style.opacity = 0;
    t.textContent = e.w;
    g.appendChild(t);
    svg.appendChild(g);
  });

  // 节点
  NODES.forEach(function(n){
    var g = document.createElementNS(NS,'g');
    g.setAttribute('data-node', n.id);
    g.style.cursor = 'pointer';
    var r = document.createElementNS(NS,'rect');
    r.setAttribute('x', pos[n.id].x - NODE_W/2); r.setAttribute('y', pos[n.id].y - NODE_H/2);
    r.setAttribute('width', NODE_W); r.setAttribute('height', NODE_H); r.setAttribute('rx', 9);
    r.setAttribute('fill','#FFFDF8');
    r.setAttribute('stroke', n.issue ? '#B3542C' : LANES[n.lane].color);
    r.setAttribute('stroke-width','1.6');
    if (n.issue) r.setAttribute('stroke-dasharray','5 3');
    g.appendChild(r);
    // 链条色点
    var c = document.createElementNS(NS,'circle');
    c.setAttribute('cx', pos[n.id].x - NODE_W/2 + 11); c.setAttribute('cy', pos[n.id].y);
    c.setAttribute('r','4'); c.setAttribute('fill', CHAIN_COLOR[n.chain]);
    g.appendChild(c);
    var t = document.createElementNS(NS,'text');
    t.setAttribute('x', pos[n.id].x + 2); t.setAttribute('y', pos[n.id].y + 4.5);
    t.setAttribute('text-anchor','middle'); t.setAttribute('font-size','12.5'); t.setAttribute('fill','#2B2620');
    t.textContent = n.name;
    g.appendChild(t);
    svg.appendChild(g);
  });
}

/* 图谱交互：悬停高亮 / 点击固定 */
var pinnedNode = null, showAllWords = false;
function nodeEdges(id){
  return EDGES.filter(function(e){ return e.f === id || e.t === id; });
}
function setNodeState(activeId, strong){
  var svg = document.getElementById('graph-svg');
  var nodes = svg.querySelectorAll('[data-node]');
  var edges = svg.querySelectorAll('[data-edge]');
  var nbrs = {};
  if (activeId){
    EDGES.forEach(function(e){
      if (e.f === activeId) nbrs[e.t] = 1;
      if (e.t === activeId) nbrs[e.f] = 1;
    });
  }
  var hc = activeId ? (nodeById[activeId].chain || '') : null;
  var hcol = (hc && CHAIN_COLOR[hc]) || '#2B2620';
  nodes.forEach(function(g){
    var n = nodeById[g.getAttribute('data-node')];
    var r = g.querySelector('rect');
    if (!activeId){
      g.style.opacity = 1;
      r.setAttribute('fill','#FFFDF8');
      r.setAttribute('stroke', n.issue ? '#B3542C' : LANES[n.lane].color);
      r.setAttribute('stroke-width','1.6');
      r.setAttribute('stroke-dasharray', n.issue ? '5 3' : '');
      return;
    }
    var isSelf = n.id === activeId;
    var on = isSelf || !!nbrs[n.id];
    if (!strong){
      g.style.opacity = on ? 1 : 0.18;
      r.setAttribute('fill','#FFFDF8');
      r.setAttribute('stroke', n.issue ? '#B3542C' : LANES[n.lane].color);
      r.setAttribute('stroke-width', isSelf ? 2.2 : 1.6);
      r.setAttribute('stroke-dasharray', n.issue ? '5 3' : '');
      return;
    }
    g.style.opacity = on ? 1 : 0.12;
    if (on){
      r.setAttribute('fill', isSelf ? (hcol + '26') : '#FFFDF8');
      r.setAttribute('stroke', hcol);
      r.setAttribute('stroke-width', isSelf ? 3 : 2);
      r.setAttribute('stroke-dasharray', n.issue ? '5 3' : '');
    } else {
      r.setAttribute('fill','#FFFDF8');
      r.setAttribute('stroke', n.issue ? '#B3542C' : LANES[n.lane].color);
      r.setAttribute('stroke-width','1.6');
      r.setAttribute('stroke-dasharray', n.issue ? '5 3' : '');
    }
  });
  edges.forEach(function(g){
    var e = EDGES[+g.getAttribute('data-edge')];
    var path = g.querySelector('path');
    var word = g.querySelector('text[data-word]');
    var on = !activeId || e.f === activeId || e.t === activeId;
    if (activeId && on){
      path.setAttribute('stroke', hcol);
      path.setAttribute('stroke-width', strong ? '3' : '2.2');
      path.setAttribute('marker-end','url(#arr-' + hc + ')');
      word.style.opacity = 1;
      g.style.opacity = 1;
    } else if (on){
      path.setAttribute('stroke','#BDB19E');
      path.setAttribute('stroke-width','1.3');
      path.setAttribute('marker-end','url(#arr)');
      word.style.opacity = showAllWords ? 1 : 0;
      g.style.opacity = 1;
    } else {
      path.setAttribute('stroke','#BDB19E');
      path.setAttribute('stroke-width','1.3');
      path.setAttribute('marker-end','url(#arr)');
      word.style.opacity = 0;
      g.style.opacity = strong ? 0.12 : 0.18;
    }
  });
}
function showDetail(id){
  var box = document.getElementById('graph-detail');
  if (!id){
    box.innerHTML = '<div class="gd-hint">点击图谱中的节点，这里会显示该主体的说明、所在链条与上下游关系。</div>';
    return;
  }
  var n = nodeById[id];
  var links = nodeEdges(id).map(function(e){
    var other = e.f === id ? nodeById[e.t] : nodeById[e.f];
    var dir = e.f === id ? '→' : '←';
    return '<span class="gd-link">' + e.w + ' ' + dir + ' ' + other.name + '</span>';
  }).join('');
  var chainBg = n.issue ? '#B3542C' : CHAIN_COLOR[n.chain];
  box.innerHTML =
    '<div class="gd-name">' + n.name + '<span class="gd-chain" style="background:' + chainBg + '">' + n.chain + '链</span></div>' +
    '<div class="gd-desc">' + n.desc + '</div>' +
    (links ? '<div class="gd-links">' + links + '</div>' : '');
}
function bindGraph(){
  var svg = document.getElementById('graph-svg');
  svg.addEventListener('mouseover', function(ev){
    var g = ev.target.closest ? ev.target.closest('[data-node]') : null;
    if (g && !pinnedNode) setNodeState(g.getAttribute('data-node'), false);
  });
  svg.addEventListener('mouseout', function(ev){
    var g = ev.target.closest ? ev.target.closest('[data-node]') : null;
    var rel = ev.relatedTarget && ev.relatedTarget.closest ? ev.relatedTarget.closest('[data-node]') : null;
    if (g && rel !== g && !pinnedNode) setNodeState(null);
  });
  svg.addEventListener('click', function(ev){
    var g = ev.target.closest ? ev.target.closest('[data-node]') : null;
    if (!g) return;
    var id = g.getAttribute('data-node');
    if (pinnedNode === id){ pinnedNode = null; setNodeState(null); showDetail(null); }
    else { pinnedNode = id; setNodeState(id, true); showDetail(id); }
  });
  document.getElementById('btn-words').addEventListener('click', function(){
    showAllWords = !showAllWords;
    this.textContent = showAllWords ? '隐藏全部关系词' : '显示全部关系词';
    var svg = document.getElementById('graph-svg');
    svg.querySelectorAll('text[data-word]').forEach(function(t){ t.style.opacity = showAllWords ? 1 : 0; });
    if (pinnedNode) setNodeState(pinnedNode, true);
  });
  document.getElementById('btn-reset').addEventListener('click', function(){
    pinnedNode = null; setNodeState(null); showDetail(null);
  });
}
function renderLegend(){
  var box = document.getElementById('graph-legend');
  var html = '<span style="font-weight:600;color:var(--ink)">图例：</span>';
  Object.keys(CHAIN_COLOR).forEach(function(k){
    var lbl = k === '问题' ? '问题节点（虚线）' : (k === '双链' ? '双链' : k + '链');
    html += '<span class="lg"><i class="dot" style="background:' + CHAIN_COLOR[k] + '"></i>' + lbl + '</span>';
  });
  html += '<span style="margin-left:8px;color:var(--muted)">色点 = 节点所属链条</span>';
  box.innerHTML = html;
}

/* ============================================================
   点位示意图（静态卡通地标，替代高德地图）
   ============================================================ */
var TOUR_POIS = [
  {id:'pottery', name:'母氏陶艺馆', short:'陶艺馆', icon:'pot', chain:'非遗文旅链', color:'#B9814A',
   x:360, y:430, side:'left',
   intro:'花茂村陶艺馆以土陶技艺为基础，由传承人和陶艺经营者完成塑形、烧制、展示与讲解，再把技艺转化为陶艺产品和游客可以亲手参与的“玩泥巴”体验，吸引普通游客和研学团队在制作过程中认识花茂土陶文化。访谈中经营者提到，过去柴窑烧坛罐要持续多天，后来改用电窑，这个变化既能体现技艺延续，也能表现传统生产方式对新条件的适应。',
   tag:'制陶 · 体验'},
  {id:'paper', name:'花茂人家 · 古法造纸', short:'造纸体验', icon:'paper', chain:'非遗文旅链', color:'#B9814A',
   x:520, y:380, side:'right',
   intro:'这里以古法造纸技艺为起点，由非遗传承人和返乡人才参与传承与创新，把造纸和纸浆压花变成可观看、可动手的制作过程，并进一步形成压花画、小夜灯、冰箱贴等文创产品，面向游客和研学团队提供体验与购买内容。它一头连接传统技艺，一头连接人才回流和文创消费，但纯手工也限制了产量，更适合突出“小而精、小而美”。',
   tag:'造纸 · 文创'},
  {id:'redhome', name:'红色之家', short:'红色之家', icon:'house', chain:'非遗文旅链', color:'#B9814A',
   x:180, y:330, side:'left',
   intro:'红色之家把苟坝红色文化、花茂村乡村故事和地方饮食放进同一个生活场景，由农家乐经营者和当地村民提供接待、餐饮与讲述。游客在参观苟坝会议纪念馆和会议遗址后，可以在八仙桌旁品尝盬子鸡、听红军过境时的军民故事，让红色记忆从纪念空间延伸到可停留、可交流、可消费的乡村体验，也为村民经营和延长游客消费链提供落点。',
   tag:'餐饮 · 故事'},
  {id:'field', name:'我在花茂有块田 · 认养区', short:'认养区', icon:'rice', chain:'农业链', color:'#2E6B4F',
   x:680, y:520, side:'right',
   intro:'“我在花茂有块田”以农田和乡村景观为资源，由农户和项目运营者组织认养、犁地、播种、采摘等活动，让游客和学生从田埂边的观看者变成农事参与者。普通农田因此获得劳动体验、自然教育和研学价值，也能帮助外来者理解农业生产、传播乡村生活；具体运营主体、收费方式和收益分配仍需进一步核实。',
   tag:'农事 · 研学'},
  {id:'farmland', name:'花茂村农田', short:'花茂村农田', icon:'farm', chain:'农业链', color:'#2E6B4F',
   x:860, y:500, side:'right',
   intro:'全村耕地约 5531 亩，2024 年形成蔬菜 1400 亩、“稻＋”1214 亩、烤烟 900 亩、脆红李 1450 亩的多元格局；经土地整治与宜机化改造，“巴掌田”“鸡窝地”连成宜机作业的连片农田，全村集中流转土地约 2350 亩。',
   tag:'多元种植'},
  {id:'jiufeng', name:'九丰农业现代高效农业园区', short:'九丰园区', icon:'gh', chain:'农业链', color:'#2E6B4F',
   x:710, y:360, side:'right',
   intro:'2014 年引入山东寿光九丰农业科技有限公司建设的现代高效农业园区；2016 年依托其管理与技术创建绿动九丰蔬菜种植专业合作社，园区内 360 亩土地上建有 34 个蔬菜大棚，带动周边农户从事设施蔬菜生产。',
   tag:'设施农业'},
  {id:'tobacco', name:'花茂村烤烟种植区', short:'烤烟种植区', icon:'leaf', chain:'农业链', color:'#2E6B4F',
   x:150, y:540, side:'left',
   intro:'全村 2024 年烤烟种植 900 亩，漂浮育苗、起垄覆膜、集中连片种植；采收编烟后进入密集烤房，机器视觉与 AI 模型辅助智能烘烤，一次约七八天，最后分级定价、合同收购，订单收入稳定。',
   tag:'烤烟 · 烘烤'},
  {id:'gouba-mem', name:'苟坝会议陈列馆', short:'苟坝陈列馆', icon:'hall', chain:'红色文化', color:'#9E2B25',
   x:330, y:140, side:'right',
   intro:'红色参观的重要起点，与花茂村文旅场景相衔接；坐标经前期项目实测核验。',
   tag:'红色 · 参观'},
  {id:'gouba-site', name:'苟坝会议会址', short:'苟坝会址', icon:'lantern', chain:'红色文化', color:'#9E2B25',
   x:505, y:90, side:'left',
   intro:'1935 年苟坝会议召开地，周边有会议遗址、真理小道、马灯馆等点位。',
   tag:'红色 · 遗址'}
];

